# Pinned defaults for generated Python runtimes.
# Release builds may override these with the matching SCRIBE_* environment
# variable, but bundle scripts should not install floating latest packages.

SCRIBE_PIP_VERSION_DEFAULT=26.1.2
SCRIBE_SETUPTOOLS_VERSION_DEFAULT=82.0.1
SCRIBE_WHEEL_VERSION_DEFAULT=0.47.0

SCRIBE_FASTER_WHISPER_VERSION_DEFAULT=1.2.1
SCRIBE_NVIDIA_CUBLAS_CU12_VERSION_DEFAULT=12.9.2.10
SCRIBE_NVIDIA_CUDNN_CU12_VERSION_DEFAULT=9.24.0.43

SCRIBE_VOSK_VERSION_DEFAULT=0.3.45

SCRIBE_SHERPA_ONNX_VERSION_DEFAULT=1.13.3
SCRIBE_SHERPA_ONNX_BIN_VERSION_DEFAULT=1.13.3
SCRIBE_NUMPY_VERSION_DEFAULT=2.5.0
